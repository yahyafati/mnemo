<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Mnemo</string>
    <string name="widget_picker_description">Today\'s cards at a glance, one tap to study</string>
    <string name="widget_study">Study</string>
    <string name="widget_done">All caught up</string>
    <plurals name="widget_cards">
        <item quantity="one">card to study</item>
        <item quantity="other">cards to study</item>
    </plurals>
    <string name="widget_detail" tools:ignore="PluralsCandidate">%1$d due · %2$d new · ~%3$d min</string>
    <plurals name="widget_streak">
        <item quantity="one">%d-day streak</item>
        <item quantity="other">%d-day streak</item>
    </plurals>
    <plurals name="widget_description">
        <item quantity="one">%d card to study today. Opens Mnemo to study.</item>
        <item quantity="other">%d cards to study today. Opens Mnemo to study.</item>
    </plurals>
</resources>
