<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules. Cloud backup: the database and preferences, without media (capped at
    25 MB; Mnemo's own backups in Settings > Data include media). Device-to-device transfer has no
    cap, so media goes too. Encrypted API keys stay out of both: they live in
    noBackupFilesDir/secrets, which is never backed up or transferred, and their Keystore key
    doesn't move with them anyway (ADR 0005).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="media/" />
    </device-transfer>
</data-extraction-rules>
