<?xml version="1.0" encoding="utf-8"?>
<!--
    Network rules (ARCHITECTURE §10, ADR 0005).

    AI providers need HTTPS, except servers the user marked local (Ollama, LM Studio …). Those are
    usually reached by LAN address (http://192.168.1.20:11434/v1), and a network security config
    can only name hosts, not address ranges, so it can't allow "the local network" by itself.
    The local-only rule is therefore enforced in code, before every request: `AiEndpoint` and
    `OpenAiCompatibleClient` send plain HTTP only to providers marked local whose host is a
    loopback, private, link-local or CGNAT address or a local name, and redirects are never
    followed, so a server can't bounce a request elsewhere. Mnemo has no other network client
    (the card WebView blocks all network loads).

    What this file adds on top: the hosted presets can never be reached over plain HTTP, and only
    the system's certificate authorities are trusted, so a user-installed CA can't read API keys.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Deliberate, see above and ADR 0005. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">openai.com</domain>
        <domain includeSubdomains="true">openrouter.ai</domain>
        <domain includeSubdomains="true">groq.com</domain>
        <domain includeSubdomains="true">together.xyz</domain>
        <domain includeSubdomains="true">together.ai</domain>
        <domain includeSubdomains="true">deepseek.com</domain>
        <domain includeSubdomains="true">mistral.ai</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
    </domain-config>
</network-security-config>
