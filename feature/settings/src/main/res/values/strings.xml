    <string name="feature_settings_about">About</string>
    <string name="feature_settings_app_name">Mnemo</string>
    <string name="feature_settings_version">Version</string>
    <string name="feature_settings_privacy">Privacy policy</string>
    <string name="feature_settings_privacy_summary">Your cards stay on this device. No accounts, no tracking.</string>
    <string name="feature_settings_privacy_local_title">Your data stays on your device</string>
    <string name="feature_settings_privacy_local">Decks, cards, review history, media and settings are stored only in the app\'s private storage. There is no Mnemo account and no Mnemo server. Backups and exports go only where you choose.</string>
    <string name="feature_settings_privacy_telemetry_title">No analytics or tracking</string>
    <string name="feature_settings_privacy_telemetry">Mnemo contains no analytics, advertising or crash-reporting code, and collects nothing about how you use it.</string>
    <string name="feature_settings_privacy_ai_title">AI features are optional</string>
    <string name="feature_settings_privacy_ai">If you add an AI provider, the text you ask about (a source for Smart Extract, a card for Explain or Rewrite, or a deck\'s cards for Co-Author) is sent directly from your device to that provider, after you confirm it once. Its privacy policy applies to what it receives.</string>
    <string name="feature_settings_privacy_keys_title">API keys</string>
    <string name="feature_settings_privacy_keys">Keys are encrypted with a key held by Android\'s keystore, never included in backups or exports, and never logged.</string>
    <string name="feature_settings_privacy_permissions_title">Permissions</string>
    <string name="feature_settings_privacy_permissions">Internet: only for AI providers and links you open in Smart Extract. Notifications: reminders and progress of long imports. Microphone: only while you dictate, and speech is recognized on your device where it can be.</string>
